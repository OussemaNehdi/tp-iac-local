*.tfstate
*.tfstate.*
# Saved plans and crash logs
*.tfplan
tfplan
crash.log
crash.*.log
# Local variable overrides (may contain secrets)
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

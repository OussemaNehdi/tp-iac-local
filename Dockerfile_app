# Dockerfile_app - blueprint of the web application image
# 1. Very small base image (Alpine, ~8 MB)
FROM alpine:latest

# 2. Install the Nginx web server (and clean the apk cache to keep the image small)
RUN apk update && \
    apk add --no-cache nginx && \
    rm -rf /var/cache/apk/*

# Alpine's default Nginx site answers 404 to everything -> replace it with a site
# that serves /var/www/localhost/htdocs
COPY app/default.conf /etc/nginx/http.d/default.conf

# 3. The page that proves the deployment worked
RUN mkdir -p /var/www/localhost/htdocs && \
    echo "<h1>Application Deployed via Terraform IaC!</h1>" > /var/www/localhost/htdocs/index.html

# 4. Nginx listens on port 80
EXPOSE 80

# Run Nginx in the foreground (otherwise the container stops immediately)
CMD ["nginx", "-g", "daemon off;"]
